---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { person, profiles, listedProfiles } from '../site';

interface Props {
  title: string;
  description: string;
  // Replaces the "<title> | AGB Labs" pattern, for pages that should lead with something else (the person's name).
  fullTitle?: string;
  // Extra JSON-LD for this page (e.g. ProfilePage, BlogPosting), alongside the site-wide Person.
  schema?: Record<string, unknown>;
  ogType?: 'website' | 'article' | 'profile';
}
const { title, description, schema, ogType = 'website' } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title === 'AGB Labs' ? 'Adam Bell, Product Manager | AGB Labs' : `${title} | AGB Labs`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const products = [
  { name: 'BumpSync', url: 'https://bumpsync.app' },
  { name: 'HushSync', url: 'https://hushsync.app' },
  { name: 'LittleSpots', url: 'https://littlespots.co.uk' },
  { name: 'Mavropost', url: 'https://mavropost.com' },
];
const hasWriting = (await getCollection('writing', (e) => e.data.published)).length > 0;
const nav = [
  { href: '/#products', label: 'Products' },
  { href: '/how-i-build/', label: 'How I build' },
  ...(hasWriting ? [{ href: '/writing/', label: 'Writing' }] : []),
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/consent.js" defer></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': person.id,
      name: person.name,
      alternateName: person.legalName,
      jobTitle: person.jobTitle,
      url: 'https://agb-labs.com/about/',
      address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: 'GB' },
      knowsAbout: ['Product management', 'Product ownership', 'Fintech', 'Car finance', 'Marketplaces', 'Building products with AI coding agents'],
      ...(profiles.length ? { sameAs: profiles.map((p) => p.url) } : {}),
      worksFor: {
        '@type': 'Organization',
        name: 'AGB Labs',
        url: 'https://agb-labs.com',
        email: 'hello@agb-labs.com',
        brand: products.map((p) => ({ '@type': 'Brand', name: p.name, url: p.url })),
      },
    })} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />}
  </head>
  <body>
    <a class="sr-only skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href="/" aria-label="AGB Labs, home">
          <svg class="brand-icon" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="2" y="2" width="13" height="13" rx="4" fill="#6b4a6e" />
            <rect x="17" y="2" width="13" height="13" rx="4" fill="#f0405a" />
            <rect x="2" y="17" width="13" height="13" rx="4" fill="#e16a47" />
            <rect x="17" y="17" width="13" height="13" rx="4" fill="#2f8a57" />
          </svg>
          <span><b>AGB</b> Labs</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) && n.href !== '/#products' ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot wrap">
      <p>AGB Labs, Manchester. Built by Adam Bell with AI coding agents.</p>
      <p class="foot-links">
        {products.map((p) => <a href={p.url}>{p.name}</a>)}
      </p>
      <p class="foot-links">
        <a href="mailto:hello@agb-labs.com">hello@agb-labs.com</a>
        {listedProfiles.map((p) => <a href={p.url} rel="me noopener">{p.label}</a>)}
        <a href="/privacy/">Privacy</a>
        <a href="/cookies/">Cookies</a>
        <a href="#" data-cookie-settings>Cookie settings</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed; left: 16px; top: 16px; width: auto; height: auto; clip: auto;
    padding: 8px 12px; background: var(--surface); z-index: 20;
  }
  .site-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }
  .head-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 60px; }
  .brand {
    display: flex; align-items: center; gap: 0.55rem;
    font-family: var(--display); font-size: 1.1rem; color: var(--ink); text-decoration: none;
  }
  .brand b { font-weight: 800; }
  .brand-icon { width: 26px; height: 26px; }
  nav { display: flex; gap: clamp(0.9rem, 3vw, 1.8rem); font-size: 0.95rem; font-weight: 500; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .site-foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    margin-top: 6rem; padding-top: 1.5rem; padding-bottom: 3rem;
    border-top: 1px solid var(--rule); color: var(--muted); font-size: 0.92rem;
  }
  .site-foot p { margin: 0; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .foot-links a { color: var(--muted); }
  .foot-links a:hover { color: var(--ink); }
</style>
