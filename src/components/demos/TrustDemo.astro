---
// LittleSpots: every facility starts as an AI estimate with a confidence, and
// gets upgraded when a parent or the venue owner confirms it. An example venue.
const facts = [
  { k: 'Baby changing', ai: 60 },
  { k: 'High chairs', ai: 92 },
  { k: 'Room for a pram', ai: 58 },
  { k: 'Kids’ menu', ai: 88 },
  { k: 'Step-free entrance', ai: 71 },
];
---
<div class="ls" data-trust>
  <div class="ls-funnel" aria-label="How the directory was filled">
    <div><b>17,106</b><span>places found in public data</span></div>
    <div><b>6,725</b><span>kept after checks</span></div>
    <div><b>359</b><span>facts confirmed by owners</span></div>
  </div>

  <article class="ls-card">
    <header class="ls-head">
      <div>
        <p class="ls-type">Café, Prestwich</p>
        <h3 class="ls-name">The Corner Kitchen</h3>
      </div>
      <span class="ls-badge" data-badge>AI estimate</span>
    </header>
    <ul class="ls-facts" role="list">
      {facts.map((f) => (
        <li data-fact>
          <span class="ls-k">{f.k}</span>
          <span class="ls-v" data-ai={`Likely, ${f.ai}% sure`}>Likely, {f.ai}% sure</span>
        </li>
      ))}
    </ul>
    <div class="ls-foot">
      <button type="button" class="ls-btn" data-ask>Ask the owner</button>
      <p class="ls-status" data-status role="status">Read from the menu, photos and reviews.</p>
    </div>
  </article>
  <p class="ls-note">An example venue. The numbers above are from the live directory.</p>
</div>

<style>
  .ls { display: grid; gap: 1rem; max-width: 460px; margin-inline: auto; }
  .ls-funnel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .ls-funnel div { background: #fff; border-radius: 16px; padding: 0.75rem; color: var(--ls-ink); }
  .ls-funnel b { display: block; font-family: var(--display); font-size: clamp(1.2rem, 4vw, 1.55rem); letter-spacing: -0.02em; }
  .ls-funnel span { display: block; font-size: 0.75rem; line-height: 1.3; margin-top: 0.2rem; color: #6d5b53; }
  .ls-funnel div:last-child { background: var(--ls-clay); color: #fff; }
  .ls-funnel div:last-child span { color: #ffe9df; }

  .ls-card { background: #fff; color: var(--ls-ink); border-radius: 22px; padding: 1.1rem; box-shadow: 0 18px 40px -22px rgba(120, 50, 20, 0.45); }
  .ls-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .ls-type { margin: 0; font-size: 0.82rem; color: #8a7369; }
  .ls-name { font-size: 1.35rem; margin-top: 0.15rem; }
  .ls-badge { font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.65rem; border-radius: 999px; background: #f4ebe5; color: #8a5a45; white-space: nowrap; transition: background 0.3s, color 0.3s; }
  .ls-badge.ok { background: #dff5f3; color: #11615c; }
  .ls-facts { list-style: none; padding: 0; margin: 0.9rem 0 0; }
  .ls-facts li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-top: 1px solid #f1e6df; font-size: 0.92rem; }
  .ls-v { color: #8a7369; text-align: right; transition: color 0.3s; }
  .ls-v.ok { color: #11615c; font-weight: 700; }
  .ls-v.ok::before { content: '✓ '; }
  .ls-foot { display: flex; align-items: center; gap: 0.8rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .ls-btn { cursor: pointer; border: 0; border-radius: 999px; min-height: 44px; padding: 0 1.1rem; background: var(--ls-clay); color: #fff; font-weight: 700; }
  .ls-btn[disabled] { opacity: 0.6; cursor: default; }
  .ls-status { margin: 0; font-size: 0.82rem; color: #8a7369; flex: 1; min-width: 12rem; }
  .ls-note { margin: 0; font-size: 0.8rem; color: var(--st-muted); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-trust]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-ask]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const badge = root.querySelector<HTMLElement>('[data-badge]')!;
    const vals = [...root.querySelectorAll<HTMLElement>('.ls-v')];
    let confirmed = false;

    btn.addEventListener('click', async () => {
      if (confirmed) {
        vals.forEach((v) => { v.textContent = v.dataset.ai!; v.classList.remove('ok'); });
        badge.textContent = 'AI estimate';
        badge.classList.remove('ok');
        status.textContent = 'Read from the menu, photos and reviews.';
        btn.textContent = 'Ask the owner';
        confirmed = false;
        return;
      }
      btn.disabled = true;
      status.textContent = 'Emailing the owner…';
      await new Promise((r) => setTimeout(r, 900));
      status.textContent = 'Owner replied. Updating…';
      // The pram answer is a correction, which is why owners are asked at all
      const answers = ['Yes', 'Yes, 4 of them', 'No, steps at the door', 'Yes', 'No'];
      for (let k = 0; k < vals.length; k++) {
        await new Promise((r) => setTimeout(r, 260));
        vals[k].textContent = answers[k];
        vals[k].classList.add('ok');
      }
      badge.textContent = 'Owner confirmed';
      badge.classList.add('ok');
      status.textContent = 'The AI got two wrong. That’s why owners are asked.';
      btn.textContent = 'Reset';
      btn.disabled = false;
      confirmed = true;
    });
  });
</script>
