---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// A rest param so /writing/ is only built once there is something in it; an empty index helps nobody.
export async function getStaticPaths() {
  const posts = await getCollection('writing', (e) => e.data.published);
  return posts.length ? [{ params: { index: undefined } }] : [];
}

const posts = (await getCollection('writing', (e) => e.data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing" description="Adam Bell on product management, building products solo with AI coding agents, and what the numbers said.">
  <section class="wrap writing">
    <h1>Writing</h1>
    <p class="lede">Notes from product work: what I decided, why, and what happened next.</p>
    <ul class="posts" role="list">
      {posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .writing { padding-top: clamp(2.5rem, 7vw, 5rem); }
  .lede { font-size: 1.3rem; line-height: 1.45; color: var(--muted); max-width: 40ch; margin-top: 1rem; }
  .posts { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 1rem; max-width: 44rem; }
  .posts a { display: block; background: var(--surface); border-radius: 20px; padding: 1.3rem 1.4rem; color: inherit; text-decoration: none; }
  .posts a:hover h2 { color: var(--link); }
  .posts h2 { font-size: 1.35rem; margin: 0; }
  .posts p { color: var(--muted); margin: 0.5rem 0 0.7rem; line-height: 1.5; }
  .posts time { font-size: 0.88rem; color: var(--muted); }
</style>
