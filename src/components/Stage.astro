---
// One product's stage on the home page: the pitch on one side, a playable
// demo on the other. Each product brings its own colours via CSS variables.
interface Props {
  id: string;
  name: string;
  status: string;
  headline: string;
  bet: string;
  result: string;
  bg: string;
  fg: string;
  accent: string;
  muted: string;
  caseHref?: string;
  siteHref?: string;
  siteLabel?: string;
  stack: string[];
  resultLabel?: string;
}
const { id, name, status, headline, bet, result, bg, fg, accent, muted, caseHref, siteHref, siteLabel, stack, resultLabel = 'What happened' } = Astro.props;
---
<section class="stage" id={id} aria-labelledby={`${id}-name`} style={`--st-bg:${bg};--st-fg:${fg};--st-accent:${accent};--st-muted:${muted}`}>
  <div class="pitch">
    <p class="who"><span id={`${id}-name`} class="pname">{name}</span><span class="status">{status}</span></p>
    <h2>{headline}</h2>
    <dl class="story">
      <div><dt>The bet</dt><dd>{bet}</dd></div>
      <div><dt>{resultLabel}</dt><dd set:html={result} /></div>
    </dl>
    <p class="stack">{stack.join(' + ')}</p>
    <p class="actions">
      {caseHref && <a class="btn" href={caseHref}>Read the case study</a>}
      {siteHref && <a class="btn ghost" href={siteHref} rel="noopener">{siteLabel ?? 'Visit'}</a>}
    </p>
  </div>
  <div class="demo">
    <slot />
  </div>
</section>

<style>
  .stage {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    background: var(--st-bg);
    color: var(--st-fg);
    border-radius: var(--radius-stage);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 1.5rem;
    scroll-margin-top: 80px;
    overflow: hidden;
  }
  @media (min-width: 940px) {
    .stage { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
  }
  .who { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.1rem; font-weight: 600; }
  .pname { font-family: var(--display); font-size: 1.2rem; font-weight: 800; letter-spacing: -0.01em; }
  .status {
    font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    background: color-mix(in srgb, var(--st-fg) 10%, transparent);
  }
  h2 { max-width: 16ch; }
  .story { margin: 1.8rem 0 0; display: grid; gap: 1.1rem; max-width: 46ch; }
  .story dt { font-family: var(--display); font-weight: 700; font-size: 0.95rem; color: var(--st-accent); }
  .story dd { margin: 0.15rem 0 0; color: var(--st-fg); }
  .story :global(strong) { font-weight: 700; }
  .stack { margin: 1.4rem 0 0; font-size: 0.88rem; color: var(--st-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.6rem 0 0; }
  .btn {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.15rem; border-radius: 999px;
    background: var(--st-fg); color: var(--st-bg); font-weight: 600; text-decoration: none; font-size: 0.95rem;
  }
  .btn.ghost { background: transparent; color: var(--st-fg); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--st-fg) 35%, transparent); }
  .btn:hover { filter: brightness(1.08); }
  .demo { min-width: 0; }
</style>
