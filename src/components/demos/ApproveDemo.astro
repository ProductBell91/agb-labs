---
// Mavropost: the agent drafts, a compliance gate blocks risky drafts before a
// human ever sees them, and nothing is published until someone taps Approve.
const drafts = [
  {
    ch: 'Pinterest pin',
    art: 'Irish baby names you will both actually agree on',
    copy: 'Swipe separately, match together. 40 Irish names couples keep landing on, from Aoife to Cillian.',
    slot: 'Tue 20:00',
  },
  {
    ch: 'Instagram carousel',
    art: 'You feel weirdly left out',
    copy: 'Six weeks in and one of you is exhausted, the other is Googling everything at 2am. Here’s what nobody tells the other half.',
    slot: 'Thu 21:00',
  },
];
---
<div class="mp" data-approve>
  <div class="mp-app">
    <div class="mp-top">
      <p class="mp-title">Mavropost</p>
      <p class="mp-counter">Published without a person: <b>0</b></p>
    </div>
    <div class="mp-tabs" role="list">
      <span role="listitem">To review <b data-c-review>2</b></span>
      <span role="listitem">Scheduled <b data-c-sched>0</b></span>
      <span role="listitem" class="blocked">Blocked <b>1</b></span>
    </div>

    <div class="mp-list">
      {drafts.map((d) => (
        <article class="mp-card" data-card data-slot={d.slot}>
          <p class="mp-ch">{d.ch}</p>
          <div class="mp-body">
            <div class="mp-art"><span>{d.art}</span></div>
            <p class="mp-copy">{d.copy}</p>
          </div>
          <div class="mp-actions">
            <button type="button" class="mp-ok" data-ok>Approve</button>
            <button type="button" class="mp-no" data-no>Reject</button>
          </div>
        </article>
      ))}
      <article class="mp-card mp-blocked">
        <p class="mp-ch">Blocked before review</p>
        <p class="mp-copy"><s>“This tea brings on labour naturally.”</s></p>
        <p class="mp-why">Compliance check: health claim. Never shown for approval.</p>
      </article>
    </div>
  </div>
</div>

<style>
  .mp { max-width: 460px; margin-inline: auto; }
  .mp-app { background: var(--mp-paper); color: var(--mp-ink); border-radius: 24px; padding: 1.1rem; box-shadow: 0 24px 50px -24px rgba(0,0,0,.6); }
  .mp-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .mp-title { margin: 0; font-family: var(--display); font-weight: 800; font-size: 1.3rem; }
  .mp-counter { margin: 0; font-size: 0.78rem; color: #5d6b62; }
  .mp-tabs { display: flex; gap: 0.4rem; margin: 0.8rem 0; flex-wrap: wrap; }
  .mp-tabs span { font-size: 0.8rem; padding: 0.3rem 0.7rem; border-radius: 999px; background: #fff; border: 1px solid #e3ded4; }
  .mp-tabs span:first-child { background: var(--mp-ink); color: #fff; border-color: var(--mp-ink); }
  .mp-tabs .blocked b { color: var(--mp-red); }
  .mp-list { display: grid; gap: 0.7rem; }
  .mp-card {
    background: #fff; border: 1px solid #e6e1d7; border-radius: 18px; padding: 0.85rem;
    transition: opacity 0.35s, transform 0.35s, background 0.3s;
  }
  .mp-ch { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 700; color: #b0305a; }
  .mp-body { display: grid; grid-template-columns: 84px 1fr; gap: 0.75rem; align-items: start; }
  .mp-art {
    aspect-ratio: 2 / 3; border-radius: 10px; padding: 0.45rem; background: linear-gradient(170deg, #f7d6e0, #e7a9be);
    font-weight: 800; font-size: 0.68rem; line-height: 1.15; color: #4a1830;
  }
  .mp-card:nth-child(2) .mp-art { aspect-ratio: 1; background: linear-gradient(170deg, #fde4d2, #f7c2c8); }
  .mp-copy { margin: 0; font-size: 0.88rem; line-height: 1.45; }
  .mp-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .mp-ok { cursor: pointer; border: 0; border-radius: 12px; min-height: 40px; padding: 0 1.1rem; background: var(--mp-green); color: #fff; font-weight: 700; }
  .mp-no { cursor: pointer; border: 0; background: none; color: #5d6b62; min-height: 40px; padding: 0 0.6rem; }
  .mp-card.done { background: #eef7f1; }
  .mp-card.rejected { opacity: 0.45; }
  .mp-card :global(.mp-state) { margin: 0.75rem 0 0; font-size: 0.85rem; font-weight: 700; color: var(--mp-green); }
  .mp-card.rejected :global(.mp-state) { color: #5d6b62; }
  .mp-blocked { background: #fbefee; border-color: #f0cfcc; }
  .mp-blocked .mp-ch { color: var(--mp-red); }
  .mp-why { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--mp-red); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-approve]').forEach((root) => {
    const review = root.querySelector<HTMLElement>('[data-c-review]')!;
    const sched = root.querySelector<HTMLElement>('[data-c-sched]')!;
    const bump = (r: number, s: number) => {
      review.textContent = String(Number(review.textContent) + r);
      sched.textContent = String(Number(sched.textContent) + s);
    };
    root.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      const actions = card.querySelector<HTMLElement>('.mp-actions')!;
      const finish = (approved: boolean) => {
        const state = document.createElement('p');
        state.className = 'mp-state';
        state.setAttribute('role', 'status');
        state.textContent = approved
          ? `Approved. Scheduled for ${card.dataset.slot}.`
          : 'Rejected. The planner learns from this.';
        actions.replaceWith(state);
        card.classList.add(approved ? 'done' : 'rejected');
        bump(-1, approved ? 1 : 0);
      };
      card.querySelector('[data-ok]')!.addEventListener('click', () => finish(true));
      card.querySelector('[data-no]')!.addEventListener('click', () => finish(false));
    });
  });
</script>
